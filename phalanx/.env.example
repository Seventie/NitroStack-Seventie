# Phalanx MCP Server Configuration

# Server
MCP_SERVER_PORT=3000
NODE_ENV=development

# Storage paths (local-first — no data leaves the machine)
STORAGE_PATH=./data/storage
MODEL_PATH=./models

# Optional: External LLM for redline drafting (Phase 3)
# Only redacted/tokenized text is ever sent externally
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# Optional: NVIDIA GLiNER API for Named Entity Recognition (Phase 1)
# NVIDIA_GLINER_API_KEY=nvapi-...
# NVIDIA_GLINER_MODEL=meta/llama3-70b-instruct

# Frontend
FRONTEND_URL=http://localhost:5173
