      "permitted disclosure list"
    ]
  },
  "dpa": {
    "label": "Data Processing Agreement",
    "description": "DPAs enumerate sub-processors and data categories. Scrub named sub-processors and transfer endpoints; keep the regulatory scaffolding intact.",
    "regexEntities": [
      "EMAIL_ADDRESS",
      "PHONE_NUMBER",
      "IP_ADDRESS",
      "URL",
      "US_SSN",
      "AADHAAR",
      "PAN"
    ],
    "contextEntities": [
      "CLIENT_NAME",
      "VENDOR_NAME",
      "JURISDICTION",
      "SIGNATORY_NAME",
      "SUBPROCESSOR_NAME",
      "DPO_NAME",
      "DATA_CENTER_LOCATION"
    ],
    "preserve": [
      "GDPR / CCPA article references",
      "breach notification windows",
      "data subject request turnaround times",
      "standard contractual clause module numbers"
    ]
  },
