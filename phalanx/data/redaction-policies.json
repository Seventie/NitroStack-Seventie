{
  "saas_msa": {
    "label": "SaaS Master Services Agreement",
    "description": "Scrub commercial terms and contact PII. Preserve legal entity names' structural role via tokens so the graph can still reason about parties.",
    "regexEntities": [
      "EMAIL_ADDRESS",
      "PHONE_NUMBER",
      "US_SSN",
      "PAN",
      "AADHAAR",
      "CREDIT_CARD",
      "IBAN",
      "BANK_ACCOUNT",
      "IP_ADDRESS",
      "URL",
      "MONEY",
      "PERCENTAGE"
    ],
    "contextEntities": [
      "CLIENT_NAME",
      "VENDOR_NAME",
      "ACV_VALUE",
      "JURISDICTION",
      "SIGNATORY_NAME"
    ],
    "preserve": [
      "governing law clause headings",
      "notice periods",
      "liability cap multipliers expressed as 'X months of fees'"
    ]
  },
  "enterprise_agreement": {
